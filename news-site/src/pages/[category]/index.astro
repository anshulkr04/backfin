---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import CategoryTabs from "../../components/CategoryTabs.astro";
import Pagination from "../../components/Pagination.astro";
import CTABanner from "../../components/CTABanner.astro";
import { getArticles, slugToCategory, categoryToSlug } from "../../lib/api";

const { category } = Astro.params;
const page = parseInt(Astro.url.searchParams.get("page") || "1");
const limit = 18;

const categoryName = slugToCategory(category || "");

let articles: any[] = [];
let totalCount = 0;

try {
  const data = await getArticles({
    article_category: categoryName,
    page,
    limit,
  });
  articles = data.articles;
  totalCount = data.count;
} catch (e) {
  console.error("Failed to fetch category articles:", e);
}

const totalPages = Math.ceil(totalCount / limit);
const baseUrl = `/${category}/`;
---

<BaseLayout
  title={`${categoryName} — MarketWire News`}
  description={`Latest ${categoryName.toLowerCase()} news from Indian corporate filings. AI-powered summaries from BSE & NSE.`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    {/* Breadcrumb */}
    <nav class="flex items-center gap-2 text-sm text-muted mb-6">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <span class="text-border">/</span>
      <span class="text-foreground">{categoryName}</span>
    </nav>

    {/* Category header */}
    <div class="mb-8">
      <h1 class="font-display font-bold text-2xl md:text-3xl text-foreground mb-2">
        {categoryName}
      </h1>
      <p class="text-muted text-sm">
        {totalCount} article{totalCount !== 1 ? "s" : ""} in this category
      </p>
    </div>

    {/* Category tabs */}
    <div class="mb-8">
      <CategoryTabs active={categoryName} />
    </div>

    {/* Articles grid */}
    {articles.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {articles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 text-muted">
        <p class="text-lg font-medium mb-2">No articles yet</p>
        <p class="text-sm">Check back soon for {categoryName.toLowerCase()} news.</p>
      </div>
    )}

    {/* Pagination */}
    <Pagination currentPage={page} totalPages={totalPages} baseUrl={baseUrl} />

    {/* CTA every few pages */}
    {page <= 2 && (
      <div class="mt-12">
        <CTABanner />
      </div>
    )}
  </div>
</BaseLayout>
