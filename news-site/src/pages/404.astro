---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found — MarketWire News">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <div class="w-20 h-20 mx-auto mb-6 bg-accent/10 rounded-2xl flex items-center justify-center">
      <span class="text-accent font-display font-bold text-3xl">404</span>
    </div>
    <h1 class="font-display font-bold text-2xl text-foreground mb-3">
      Page not found
    </h1>
    <p class="text-muted text-sm mb-8 max-w-md mx-auto">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <div class="flex items-center justify-center gap-3">
      <a
        href="/"
        class="px-5 py-2.5 bg-accent hover:bg-accent-hover text-white font-semibold text-sm rounded-lg transition-colors"
      >
        Go Home
      </a>
      <a
        href="/wire/"
        class="px-5 py-2.5 bg-surface text-foreground font-medium text-sm rounded-lg border border-border hover:border-accent/30 transition-colors"
      >
        Live Wire
      </a>
    </div>
  </div>
</BaseLayout>
