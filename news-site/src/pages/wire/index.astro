---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLatestArticles, sentimentColor, timeAgo, categoryToSlug } from "../../lib/api";
import CTABanner from "../../components/CTABanner.astro";

let articles: any[] = [];

try {
  articles = await getLatestArticles(30);
} catch (e) {
  console.error("Failed to fetch wire articles:", e);
}
---

<BaseLayout
  title="Live Wire — Latest Corporate Filings — MarketWire News"
  description="Real-time feed of AI-summarized corporate filings from BSE & NSE."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    {/* Header */}
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="w-3 h-3 bg-accent rounded-full animate-pulse"></span>
        <h1 class="font-display font-bold text-2xl text-foreground">Live Wire</h1>
      </div>
      <p class="text-muted text-sm">
        Real-time corporate filing updates. Every article as it breaks.
      </p>
    </div>

    {/* Wire feed */}
    {articles.length > 0 ? (
      <div class="space-y-0 divide-y divide-border border border-border rounded-xl overflow-hidden bg-white">
        {articles.map((article) => {
          const catSlug = categoryToSlug(article.article_category);
          const url = `/${catSlug}/${article.slug}/`;
          return (
            <a href={url} class="group flex items-start gap-4 p-5 hover:bg-surface transition-colors">
              {/* Time column */}
              <div class="flex-shrink-0 w-16 text-right">
                <time datetime={article.published_at} class="text-xs text-muted font-mono">
                  {timeAgo(article.published_at)}
                </time>
              </div>

              {/* Content */}
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="badge badge-category text-[10px]">
                    {article.article_category}
                  </span>
                  <span class={`badge text-[10px] ${sentimentColor(article.sentiment)}`}>
                    {article.sentiment}
                  </span>
                </div>
                <h3 class="font-medium text-sm text-foreground group-hover:text-accent transition-colors line-clamp-2 leading-snug mb-1">
                  {article.headline}
                </h3>
                <div class="flex items-center gap-2 text-xs text-muted">
                  <span class="font-medium">{article.companyname}</span>
                  <span class="text-border">&bull;</span>
                  <span>{article.symbol}</span>
                </div>
              </div>

              {/* Arrow */}
              <div class="flex-shrink-0 mt-4 text-muted group-hover:text-accent transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="text-center py-16 text-muted">
        <p class="text-lg font-medium mb-2">Wire is quiet</p>
        <p class="text-sm">Articles will appear here as filings are processed.</p>
      </div>
    )}

    {/* Lead gen gate: prompt sign up after showing some */}
    <div class="mt-8 bg-surface border border-border rounded-xl p-6 text-center">
      <p class="font-display font-bold text-lg text-foreground mb-2">
        Want faster alerts?
      </p>
      <p class="text-sm text-muted mb-4">
        MarketWire sends filing notifications the second they drop. Set up watchlists, filter by sector.
      </p>
      <a
        href="https://marketwire.app"
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent hover:bg-accent-hover text-white font-semibold text-sm rounded-lg transition-colors"
      >
        Get Real-Time Alerts &rarr;
      </a>
    </div>

    <div class="mt-10">
      <CTABanner />
    </div>
  </div>
</BaseLayout>
