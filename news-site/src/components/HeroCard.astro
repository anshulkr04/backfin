---
import { sentimentColor, timeAgo, categoryToSlug } from "../lib/api";
import type { Article } from "../lib/api";

interface Props {
  article: Article;
}

const { article } = Astro.props;
const categorySlug = categoryToSlug(article.article_category);
const articleUrl = `/${categorySlug}/${article.slug}/`;
---

<a href={articleUrl} class="group block">
  <article class="relative overflow-hidden rounded-xl bg-gradient-to-br from-gray-900 to-gray-800 p-8 md:p-10 min-h-[360px] flex flex-col justify-end text-white">
    <!-- Category + Sentiment -->
    <div class="flex items-center gap-2 mb-4">
      <span class="badge badge-category !bg-accent/20 !text-orange-200">
        {article.article_category}
      </span>
      <span class={`badge ${sentimentColor(article.sentiment)} !bg-opacity-20`}>
        {article.sentiment}
      </span>
    </div>

    <!-- Headline -->
    <h2 class="font-display font-bold text-2xl md:text-3xl lg:text-4xl leading-tight mb-3 group-hover:text-accent transition-colors">
      {article.headline}
    </h2>

    <!-- Description -->
    <p class="text-gray-300 text-base md:text-lg leading-relaxed mb-4 line-clamp-2">
      {article.seo_description}
    </p>

    <!-- Meta -->
    <div class="flex items-center gap-3 text-sm text-gray-400">
      <span class="font-medium text-orange-300">{article.companyname}</span>
      <span class="text-gray-600">&bull;</span>
      <span>{article.symbol}</span>
      <span class="text-gray-600">&bull;</span>
      <time datetime={article.published_at}>{timeAgo(article.published_at)}</time>
    </div>

    <!-- Gradient overlay for depth -->
    <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-transparent to-transparent -z-10"></div>
  </article>
</a>
